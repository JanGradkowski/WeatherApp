<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="450.0" styleClass="root-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.weather_app.DetailsController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Button mnemonicParsing="false" onAction="#goBack" styleClass="popular-btn" text="← Back" />
                            <HBox HBox.hgrow="ALWAYS" />
                            <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#saveCity" styleClass="popular-btn" text="♡ Save" />
                        </HBox>

                        <VBox alignment="CENTER" spacing="10.0">
                            <Label fx:id="cityNameLabel" style="-fx-font-size: 42px; -fx-text-fill: white; -fx-font-weight: bold;" text="CITY" />
                            <Label fx:id="currentTempLabel" style="-fx-font-size: 64px; -fx-text-fill: white;" text="--°" />
                            <Label fx:id="currentDescLabel" style="-fx-font-size: 20px; -fx-text-fill: rgba(255,255,255,0.8);" text="Description" />
                        </VBox>

                        <Label styleClass="section-title" text="Today" />
                        <VBox fx:id="forecastContainer" spacing="10.0" />

                        <Label styleClass="section-title" text="Next 5 Days" />
                        <VBox fx:id="dailyForecastContainer" spacing="10.0" />

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>